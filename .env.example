# Variáveis de ambiente do backend (nunca versione valores reais).
DB_URL=jdbc:postgresql://localhost:5433/financebalance
DB_USER=financebalance
DB_PASSWORD=financebalance
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32-ou-mais-caracteres
# Duração do token (formato ISO-8601). Padrão: 1 hora.
JWT_EXPIRATION=PT1H
# Origens permitidas no CORS, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173
